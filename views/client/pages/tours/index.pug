extends ../../layouts/default.pug
include ../../mixins/box-head.pug
block main
    .container.my-3
        .row
            .col-12
                +box-head(pageTitle)

        .row
            each tour in tours
                .col-6.mb-3
                    div(class="card")
                        img(src=tour.image)
                        div(class="card-body")
                            h5(class="card-title") #{tour.title}
                            b(class="mr-2 mb-2") #{tour.price_special.toLocaleString()}đ
                            del(class="mb-2") #{tour.price.toLocaleString()}đ
                            p(class="font-weight-bold") Giảm #{tour.discount}%
                            a(href=`/tours/detail/${tour.slug}`, class="btn btn-primary") Xem chi tiết
